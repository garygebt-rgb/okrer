# Reports (may contain user data)
**/reports/*
!.gitkeep

# Environment files
**/.env*

# Claude/IDE specific
**/.claude/
**/.continue-here*
**/.continue*

# OS files
.DS_Store

# Node
node_modules/

# Build artifacts
*.tsbuildinfo
